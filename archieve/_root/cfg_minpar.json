      ]
    },
    {
      "name": "P1024",
      "defines": [
        "CPS_MIN_PAR=1024"
      ]
    },
    {
      "name": "P512",
      "defines": [
        "CPS_MIN_PAR=512"
      ]
    },
    {
      "name": "P256",
      "defines": [
        "CPS_MIN_PAR=256"
      ]
    },
    {
      "name": "P128",
      "defines": [
        "CPS_MIN_PAR=128"
      ]
    },
    {
      "name": "P64",
      "defines": [
        "CPS_MIN_PAR=64"
      ]
    }
  ],
  "baseline": "P2048",
  "cases": [
    "r_nearly_zero_01",
    "burnikel_ziegler_bound_02",
